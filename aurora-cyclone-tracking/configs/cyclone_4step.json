{
  "task": "cyclone",
  "model": "pretrained",
  "store": "data/cyclone_1p5.zarr",
  "train_start": "2016-01-01",
  "train_end": "2020-12-31",
  "val_start": "2021-01-01",
  "val_end": "2021-12-31",
  "test_start": "2022-01-01",
  "test_end": "2022-12-31",
  "trainable": "full",
  "precision": "bf16",
  "activation_checkpointing": true,
  "batch_size": 1,
  "accumulation_steps": 4,
  "rollout_steps": 4,
  "detach_every": 0,
  "max_steps": 10000,
  "warmup_steps": 500,
  "learning_rate": 5e-06,
  "adapter_learning_rate": 0.0001,
  "weight_decay": 5e-06,
  "clip_grad_norm": 1.0,
  "seed": 42,
  "workers": 0,
  "validate_every": 250,
  "validation_batches": 32,
  "save_every": 250,
  "adapter_channels": 32,
  "flow_groups": 4,
  "transport_substeps": 1,
  "adr_transport": "push",
  "motion_regularization": 0.0001,
  "nowcast_aux_weight": 0.5,
  "loss": "mae",
  "area_weighted_loss": false,
  "loss_overrides": {
    "surf__2t": 3.5,
    "surf__msl": 1.6,
    "atmos__z": 3.5,
    "atmos__q": 0.8
  }
}
